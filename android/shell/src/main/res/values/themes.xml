<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Shell" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/shell_background</item>
        <item name="android:statusBarColor">@color/shell_background</item>
        <item name="android:navigationBarColor">@color/shell_background</item>
        <item name="colorAccent">@color/shell_accent</item>
    </style>

    <style name="Theme.Shell.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/shell_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/shell_splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Shell</item>
    </style>
</resources>
